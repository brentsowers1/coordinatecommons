# Copy this file to `.env` (or `.env.local`) and fill in real values for
# local development. See src/config.js for how these are consumed.
#
# None of these are secrets requiring protection: the Google Maps API key
# and Cognito app client id are inherently client-visible values shipped to
# the browser by design (restrict the Maps key by HTTP referrer in the
# Google Cloud Console instead of trying to keep it private).
#
# The Google Maps API key kept in `.env` is expected to be restricted (in
# Google Cloud Console) to the production domain, so it gets rejected with
# `RefererNotAllowedMapError` when run from `localhost`. To work around
# this locally, put a separate key with no HTTP-referrer restriction (or
# one that explicitly allows `localhost`) in `.env.development.local` --
# Vite automatically loads that file (in addition to `.env`) under mode
# `development`, which both `npm run dev` and the e2e suite (`npm run
# test:e2e`, see playwright.config.js) use, while `npm run build` (mode
# `production`) never loads it and keeps using the restricted `.env` key.

# Base URL of the existing Visit_Record_API (API Gateway + Lambda backend).
VISIT_RECORD_API_BASE_URL=https://api.example.com/prod

# Google Maps JavaScript API key.
GOOGLE_MAPS_API_KEY=

# AWS Cognito user pool settings.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_REGION=us-east-1