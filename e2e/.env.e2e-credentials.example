# Copy this file to `.env.e2e-credentials.local` (same directory) and fill
# in a real Cognito user pool account's credentials for the persistence
# e2e test (toggleVisitedStatePersists.spec.js) to run against. Strongly
# recommend using a DEDICATED test account distinct from any real/personal
# login, since this test actually marks and unmarks a real state as
# "visited" for whichever account these credentials belong to via the real
# Visit_Record_API backend.
E2E_TEST_USERNAME=
E2E_TEST_PASSWORD=
